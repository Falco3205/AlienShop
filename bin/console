#!/usr/bin/env php
<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    exit(1);
}
define('ROOT', dirname(__DIR__));
require ROOT . '/app/bootstrap.php';

use Alien\Core\Cache;
use Alien\Core\Config;
use Alien\Core\DB;
use Alien\Core\Lang;
use Alien\Core\Settings;
use Alien\Import\Exporter;
use Alien\Import\ShopifyImporter;
use Alien\Import\WooImporter;
use Alien\Services\Orders;
use Alien\Services\Themes;

if (($argv[1] ?? '') === 'install') {
    $o = [];
    foreach (array_slice($argv, 2) as $a) {
        if (preg_match('/^--([a-z0-9-]+)(?:=(.*))?$/s', $a, $m)) {
            $o[$m[1]] = $m[2] ?? '1';
        }
    }
    $env = static fn(string $k, string $default = '') => $o[$k] ?? (getenv('ALIEN_' . strtoupper(str_replace('-', '_', $k))) ?: $default);
    if (Config::installed()) {
        fwrite(STDERR, "AlienShop è già installato.\n");
        exit(1);
    }
    $data = [
        'db_driver' => $env('db', 'sqlite'),
        'db_host' => $env('db-host', 'localhost'), 'db_port' => $env('db-port', '3306'),
        'db_name' => $env('db-name'), 'db_user' => $env('db-user'), 'db_pass' => $env('db-pass'),
        'app_url' => $env('url'), 'store_name' => $env('store-name', 'AlienShop'),
        'store_email' => $env('store-email', $env('admin-email')),
        'store_tagline' => $env('tagline'), 'lang' => $env('lang', 'it'), 'currency' => $env('currency', 'EUR'),
        'country' => $env('country', 'IT'), 'tax_rate' => $env('tax-rate', '22'), 'prices_include_tax' => $env('prices-include-tax', '1'),
        'admin_name' => $env('admin-name', 'Admin'), 'admin_email' => $env('admin-email'),
        'admin_password' => $env('admin-password'), 'admin_password2' => $env('admin-password'),
        'theme' => $env('theme', 'aurora'), 'demo' => $env('demo', '0') === '1' ? 1 : 0,
    ];
    $_SERVER['HTTP_HOST'] = $_SERVER['HTTP_HOST'] ?? (parse_url($data['app_url'], PHP_URL_HOST) ?: 'localhost');
    $errors = Alien\Services\Installer::validate($data);
    if ($errors) {
        fwrite(STDERR, "Installazione non riuscita:\n - " . implode("\n - ", $errors) . "\n");
        exit(1);
    }
    Alien\Services\Installer::install($data);
    $proxies = array_values(array_filter(array_map('trim', explode(',', $env('trusted-proxies')))));
    if ($proxies) {
        $cfg = Config::all();
        $cfg['app']['trusted_proxies'] = $proxies;
        Config::write($cfg);
    }
    if ($env('hub-secret') !== '') {
        DB::boot();
        Alien\Services\HubAgent::connect($env('hub-url'), $env('hub-secret'));
    }
    echo "AlienShop installato. Pannello: " . rtrim($data['app_url'] ?: Config::baseUrl(), '/') . "/admin\n";
    exit(0);
}

if (!Config::installed()) {
    fwrite(STDERR, "AlienShop non è installato. Apri /install nel browser.\n");
    exit(1);
}
DB::boot();
Lang::load((string)Settings::get('locale', 'it'));
@set_time_limit(0);

[$script, $command] = array_pad($argv, 2, '');
$args = array_slice($argv, 2);
$flags = array_filter($args, static fn($a) => str_starts_with($a, '--'));
$args = array_values(array_filter($args, static fn($a) => !str_starts_with($a, '--')));

switch ($command) {
    case 'import:woocommerce':
    case 'import:shopify':
        if (!isset($args[0]) || !is_file($args[0])) {
            fwrite(STDERR, "Uso: console $command <file.csv> [--no-images] [--no-update]\n");
            exit(1);
        }
        $importer = $command === 'import:shopify' ? new ShopifyImporter() : new WooImporter();
        $result = $importer->import($args[0], !in_array('--no-images', $flags, true), !in_array('--no-update', $flags, true));
        Cache::flush();
        echo $result->summary() . "\n";
        foreach ($result->errors as $e) {
            echo " - $e\n";
        }
        exit($result->created + $result->updated > 0 ? 0 : 1);

    case 'export:woocommerce':
    case 'export:shopify':
        $csv = $command === 'export:shopify' ? Exporter::shopify() : Exporter::woo();
        $out = $args[0] ?? 'php://stdout';
        file_put_contents($out, $csv);
        exit(0);

    case 'orders:expire':
        $hours = (int)($args[0] ?? 48);
        $cutoff = date('Y-m-d H:i:s', time() - $hours * 3600);
        $n = 0;
        foreach (DB::all("SELECT id FROM orders WHERE status = 'pending' AND payment_status = 'unpaid' AND payment_method IN ('stripe','paypal') AND created_at < ?", [$cutoff]) as $o) {
            Orders::setStatus((int)$o['id'], 'cancelled');
            $n++;
        }
        echo "Ordini online non pagati annullati: $n\n";
        exit(0);

    case 'user:password':
        if (count($args) < 2 || strlen($args[1]) < 8) {
            fwrite(STDERR, "Uso: console user:password <email> <nuova-password (min 8)>\n");
            exit(1);
        }
        $u = DB::row('SELECT id FROM users WHERE email = ?', [mb_strtolower($args[0])]);
        if (!$u) {
            fwrite(STDERR, "Utente non trovato.\n");
            exit(1);
        }
        Alien\Core\Auth::setPassword((int)$u['id'], $args[1]);
        echo "Password aggiornata.\n";
        exit(0);

    case 'backup:create':
        $zipPath = Alien\Services\Backup::zipAvailable() ? Alien\Services\Backup::fullArchive() : Alien\Services\Backup::databaseFile()[1];
        $target = $args[0] ?? (ROOT . '/storage/backup-' . date('Ymd-His') . (Alien\Services\Backup::zipAvailable() ? '.zip' : '.bak'));
        rename($zipPath, $target);
        echo "Backup creato: $target\n";
        exit(0);

    case 'backup:restore':
        if (!isset($args[0]) || !is_file($args[0])) {
            fwrite(STDERR, "Uso: console backup:restore <file.zip|file.sqlite|file.sql>\n");
            exit(1);
        }
        echo Alien\Services\Backup::restore($args[0]) . "\n";
        exit(0);

    case 'cron:run':
        echo json_encode(Alien\Services\Cron::run()) . "\n";
        exit(0);

    case 'update':
        $st = Alien\Services\Updater::status(true);
        if ($st['error']) {
            fwrite(STDERR, $st['error'] . "\n");
            exit(1);
        }
        if (!$st['available']) {
            echo "Già aggiornato (" . substr($st['current'], 0, 7) . ").\n";
            exit(0);
        }
        echo "Aggiornamento disponibile: " . substr($st['current'], 0, 7) . " -> " . substr($st['latest']['sha'], 0, 7) . " " . ($st['latest']['message'] ?? '') . "\n";
        if (in_array('--check', $flags, true)) {
            exit(0);
        }
        $r = Alien\Services\Updater::apply();
        echo $r['message'] . "\n";
        exit($r['ok'] ? 0 : 1);

    case 'update:rollback':
        $r = Alien\Services\Updater::rollback();
        echo $r['message'] . "\n";
        exit($r['ok'] ? 0 : 1);

    case 'hub:connect':
        if (!isset($args[0], $args[1])) {
            fwrite(STDERR, "Uso: console hub:connect <url-hub> <secret>\n");
            exit(1);
        }
        Alien\Services\HubAgent::connect($args[0], $args[1]);
        echo "Collegato all'hub.\n";
        exit(0);

    case 'migrate':
        Alien\Services\Migrator::run();
        echo "Database aggiornato.\n";
        exit(0);

    case 'cache:clear':
        Cache::flush();
        Themes::build(Alien\Core\View::theme());
        echo "Cache svuotata.\n";
        exit(0);

    default:
        echo "AlienShop " . ALIEN_VERSION . "\n\nComandi:\n"
            . "  install --url=https://dominio --admin-email=.. --admin-password=.. [--db=mysql --db-name=.. --db-user=.. --db-pass=..] [--store-name=..] [--theme=aurora] [--demo=1] [--trusted-proxies=ip,cidr] [--hub-url=.. --hub-secret=..]\n"
            . "  import:woocommerce <file.csv> [--no-images] [--no-update]\n"
            . "  import:shopify <file.csv> [--no-images] [--no-update]\n"
            . "  export:woocommerce [file.csv]\n  export:shopify [file.csv]\n"
            . "  orders:expire [ore=48]   annulla ordini Stripe/PayPal non pagati (da usare in cron)\n"
            . "  user:password <email> <password>   reimposta la password di un utente\n"
            . "  backup:create [file] | backup:restore <file>\n  cron:run   esegue le attività pianificate (email, promemoria, scadenze)\n  migrate    aggiorna il database\n"
            . "  update [--check]   aggiorna da GitHub (o solo controlla)\n  update:rollback   torna alla versione precedente\n"
            . "  cache:clear\n";
        exit($command === '' ? 0 : 1);
}
