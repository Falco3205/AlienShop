Options -Indexes
ServerSignature Off
<FilesMatch "(^\.|\.(sql|sqlite|sqlite3|log|sh|bak|lock|key|md|dist|yml|yaml|json|neon)$)">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(app|config|database|storage|themes|views|bin|tests|lang|hub|node|docs)(/|$) - [F,L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
