#!/usr/bin/env php
<?php
declare(strict_types=1);

const AGENT_VERSION = '2.0.0';

class Node
{
    public array $log = [];
    public bool $dry = false;
    private array $redact = [];
    private array $cfg;

    public function __construct(array $cfg, bool $dry = false)
    {
        $this->cfg = $cfg + ['hestia' => '/usr/local/hestia', 'users' => [], 'repo' => 'Falco3205/AlienShop', 'branch' => 'main', 'role' => 'backend'];
        $this->dry = $dry;
    }

    public static function loadConfig(): array
    {
        $file = getenv('ALIENSHOP_NODE_CONF') ?: '/etc/alienshop/node.json';
        $cfg = is_file($file) ? json_decode((string)file_get_contents($file), true) : null;
        if (!is_array($cfg) || empty($cfg['hub']) || empty($cfg['token'])) {
            fwrite(STDERR, "Configurazione mancante o incompleta: $file\n");
            exit(1);
        }
        $stackFile = getenv('ALIENSHOP_STACK_CONF') ?: '/etc/alienshop/stack.json';
        $stack = is_file($stackFile) ? json_decode((string)file_get_contents($stackFile), true) : null;
        return $cfg + (is_array($stack) ? $stack : []);
    }

    public function say(string $line): void
    {
        $line = $this->redact ? str_replace($this->redact, '********', $line) : $line;
        $this->log[] = $line;
        if (PHP_SAPI === 'cli' && !$this->dry) {
            fwrite(STDOUT, $line . "\n");
        }
    }

    public function http(string $method, string $path, array $body = []): array
    {
        $ctx = stream_context_create(['http' => [
            'method' => $method,
            'header' => "Authorization: Bearer {$this->cfg['token']}\r\nContent-Type: application/json\r\nUser-Agent: alienshop-node/" . AGENT_VERSION . "\r\n",
            'content' => $body ? json_encode($body) : '',
            'timeout' => 30,
            'ignore_errors' => true,
        ]]);
        $raw = @file_get_contents(rtrim((string)$this->cfg['hub'], '/') . $path, false, $ctx);
        $status = 0;
        foreach ($http_response_header ?? [] as $h) {
            if (preg_match('#^HTTP/\S+\s+(\d{3})#', $h, $m)) {
                $status = (int)$m[1];
            }
        }
        return ['status' => $status, 'json' => is_string($raw) ? (json_decode($raw, true) ?: []) : []];
    }

    public function info(): array
    {
        $mem = 0;
        if (is_readable('/proc/meminfo')) {
            $t = file_get_contents('/proc/meminfo');
            if (preg_match('/MemTotal:\s+(\d+)/', $t, $a) && preg_match('/MemAvailable:\s+(\d+)/', $t, $b) && (int)$a[1] > 0) {
                $mem = (int)round(100 - $b[1] / $a[1] * 100);
            }
        }
        $disk = @disk_total_space('/') ?: 0;
        $hestia = '';
        $conf = $this->cfg['hestia'] . '/conf/hestia.conf';
        if (is_readable($conf) && preg_match('/^VERSION=[\'"]?([\d.]+)/m', (string)file_get_contents($conf), $m)) {
            $hestia = $m[1];
        }
        return [
            'hostname' => gethostname() ?: '', 'os' => php_uname('s') . ' ' . php_uname('r'), 'php' => PHP_VERSION, 'agent' => AGENT_VERSION,
            'hestia' => $hestia, 'load' => round((sys_getloadavg()[0] ?? 0), 2),
            'disk_used_pct' => $disk ? (int)round(100 - disk_free_space('/') / $disk * 100) : 0, 'mem_used_pct' => $mem,
        ];
    }

    public function run(): int
    {
        $r = $this->http('POST', '/api/node/poll', ['info' => $this->info()]);
        if ($r['status'] !== 200) {
            fwrite(STDERR, "Hub non raggiungibile o token non valido (HTTP {$r['status']}).\n");
            return 1;
        }
        foreach ($r['json']['jobs'] ?? [] as $job) {
            $this->execute((int)$job['id'], (string)$job['type'], (array)$job['payload']);
        }
        return 0;
    }

    public function claim(string $user, string $domain): int
    {
        try {
            if (($this->cfg['role'] ?? '') !== 'edge') {
                throw new RuntimeException('Il collegamento con Hestia è solo per il frontend.');
            }
            $this->validate(['hestia_user' => $user, 'domain' => $domain], ['hestia_user' => 'user', 'domain' => 'domain']);
        } catch (RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . "\n");
            return 1;
        }
        $r = $this->http('POST', '/api/node/claim', ['user' => $user, 'domain' => $domain]);
        if ($r['status'] !== 200) {
            fwrite(STDERR, 'Hub: ' . ($r['json']['error'] ?? 'HTTP ' . $r['status']) . "\n");
            return 1;
        }
        echo "Dominio $domain registrato nell'hub: backend e frontend verranno configurati a breve.\n";
        return 0;
    }

    public function execute(int $id, string $type, array $p): void
    {
        $this->log = [];
        $this->redact = [];
        try {
            $result = match ($type) {
                'install_shop' => $this->installShop($p),
                'add_edge' => $this->addEdge($p),
                'suspend_shop' => $this->suspend($p, true),
                'unsuspend_shop' => $this->suspend($p, false),
                'node_update' => $this->selfUpdate(),
                default => throw new RuntimeException('Tipo di attività sconosciuto: ' . $type),
            };
            $this->report($id, true, $result, '');
        } catch (Throwable $e) {
            $this->say('ERRORE: ' . $e->getMessage());
            $this->report($id, false, [], $e->getMessage());
        }
    }

    private function report(int $id, bool $ok, array $result, string $error): void
    {
        if ($this->dry) {
            return;
        }
        $this->http('POST', '/api/node/jobs/' . $id, ['ok' => $ok, 'result' => $result, 'error' => $error, 'log' => implode("\n", $this->log)]);
    }

    private function validate(array $p, array $rules): void
    {
        $patterns = [
            'domain' => '/^(?=.{4,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,24}$/',
            'user' => '/^[a-z][a-z0-9_-]{0,31}$/',
            'path' => '/^([a-z0-9][a-z0-9_-]{0,40})?$/',
            'repo' => '#^[\w.-]+/[\w.-]+$#',
            'branch' => '#^[\w./-]{1,60}$#',
            'theme' => '/^[a-z0-9_-]{1,40}$/',
            'lang' => '/^(it|en)$/',
            'secret' => '/^[0-9a-f]{20,128}$/',
            'url' => '#^https?://[\w.\-]+(:\d+)?(/[a-z0-9_-]+)?$#',
            'upstream' => '#^https?://[\w.\-\[\]:]+$#',
        ];
        foreach ($rules as $key => $kind) {
            if (!isset($p[$key]) || !is_string($p[$key]) || !preg_match($patterns[$kind] . 'D', $p[$key])) {
                throw new RuntimeException("Parametro non valido: $key");
            }
        }
        if (isset($p['hestia_user'])) {
            $allowed = $this->cfg['users'] ?: [$this->cfg['user'] ?? ''];
            if (!in_array($p['hestia_user'], $allowed, true)) {
                throw new RuntimeException('Utente Hestia non autorizzato su questo server: ' . $p['hestia_user']);
            }
        }
    }

    public function sh(array $cmd, ?string $user = null, array $env = [], bool $mustSucceed = true, ?string $stdin = null): array
    {
        if ($user !== null) {
            $cmd = ['runuser', '-u', $user, '--', ...$cmd];
        }
        $shown = implode(' ', array_map(static fn($a) => preg_match('/^[\w@%+=:,.\/-]+$/', $a) ? $a : "'" . str_replace("'", "'\\''", $a) . "'", $cmd));
        $this->say('$ ' . $shown . ($stdin !== null ? ' < (SQL)' : ''));
        if ($this->dry) {
            return [0, ''];
        }
        $proc = proc_open($cmd, [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, $env + ['PATH' => '/usr/local/hestia/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin', 'HOME' => $user ? "/home/$user" : '/root', 'GIT_TERMINAL_PROMPT' => '0', 'HESTIA' => $this->cfg['hestia']]);
        if (!is_resource($proc)) {
            throw new RuntimeException('Impossibile eseguire: ' . $cmd[0]);
        }
        if ($stdin !== null) {
            fwrite($pipes[0], $stdin);
        }
        fclose($pipes[0]);
        $out = trim(stream_get_contents($pipes[1]) . stream_get_contents($pipes[2]));
        fclose($pipes[1]);
        fclose($pipes[2]);
        $code = proc_close($proc);
        if ($out !== '') {
            $this->say(mb_substr($out, 0, 1500));
        }
        if ($mustSucceed && $code !== 0) {
            throw new RuntimeException("Comando fallito ({$cmd[0]}, codice $code)");
        }
        return [$code, $out];
    }

    private function hestia(string $cmd, array $args, bool $mustSucceed = true): array
    {
        return $this->sh([$this->cfg['hestia'] . '/bin/' . $cmd, ...$args], null, [], $mustSucceed);
    }

    private function write(string $file, string $content, int $mode = 0644, ?string $owner = null): void
    {
        $this->say("scrivo $file");
        if ($this->dry) {
            return;
        }
        @mkdir(dirname($file), 0755, true);
        file_put_contents($file, $content);
        chmod($file, $mode);
        if ($owner) {
            @chown($file, $owner);
        }
    }

    private function emptyish(string $dir): bool
    {
        if (!is_dir($dir)) {
            return true;
        }
        foreach (scandir($dir) ?: [] as $f) {
            if (!in_array($f, ['.', '..'], true)) {
                return false;
            }
        }
        return true;
    }

    private function stack(string $key, string $default = ''): string
    {
        return (string)($this->cfg[$key] ?? $default);
    }

    public function names(string $domain, string $path): array
    {
        $label = substr(preg_replace('/[^a-z0-9]/', '', explode('.', $domain)[0]) ?: 'shop', 0, 10);
        $slug = $label . '_' . substr(sha1($domain . '/' . $path), 0, 4);
        return [$slug, 'as_' . $slug];
    }

    public function installShop(array $p): array
    {
        $this->validate($p, ['domain' => 'domain', 'path' => 'path', 'repo' => 'repo', 'branch' => 'branch', 'theme' => 'theme', 'lang' => 'lang', 'hub_secret' => 'secret', 'url' => 'url']);
        if (!filter_var($p['admin_email'] ?? '', FILTER_VALIDATE_EMAIL) || !isset($p['admin_password']) || strlen((string)$p['admin_password']) < 12 || !preg_match('/^[\w.~-]+$/D', (string)$p['admin_password'])) {
            throw new RuntimeException('Parametri amministratore non validi.');
        }
        if (!preg_match('#^https?://[\w.\-]+(:\d+)?(/[\w./-]*)?$#D', (string)($p['hub_url'] ?? ''))) {
            throw new RuntimeException('Parametro non valido: hub_url');
        }
        $proxies = array_values((array)($p['trusted_proxies'] ?? []));
        foreach ($proxies as $px) {
            if (!is_string($px) || !preg_match('#^[0-9a-fA-F:.]+(/\d{1,3})?$#D', $px)) {
                throw new RuntimeException('Proxy fidato non valido.');
            }
        }
        $this->redact = array_values(array_filter([(string)$p['admin_password'], (string)$p['hub_secret']]));
        $domain = $p['domain'];
        $path = $p['path'];
        [$slug, $user] = $this->names($domain, $path);
        $base = $this->stack('base', '/var/www/alienshop');
        $home = "$base/shops/$slug";
        $app = "$home/app";
        $phpv = $this->stack('php');
        $listen = $this->stack('listen');
        $nginxUser = $this->stack('nginx_user', 'www-data');
        if (!$this->dry && (!preg_match('/^\d\.\d$/D', $phpv) || !preg_match('/^(\d{1,3}\.){3}\d{1,3}$/D', $listen))) {
            throw new RuntimeException('Il server non è preparato: esegui prima node/stack.sh.');
        }
        $name = (string)($p['store_name'] ?? $domain);
        $name = trim(preg_replace('/[^\p{L}\p{N} .,&\'-]/u', '', $name) ?? '') ?: $domain;
        $this->say("== Installazione di $domain" . ($path ? "/$path" : '') . " (utente $user)");

        [$exists] = $this->sh(['id', '-u', $user], null, [], false);
        if ($exists !== 0 || $this->dry) {
            $this->sh(['useradd', '--system', '--home-dir', $home, '--no-create-home', '--shell', '/usr/sbin/nologin', '--user-group', $user]);
        }
        $this->sh(['usermod', '-aG', $user, $nginxUser]);
        $this->sh(['install', '-d', '-o', $user, '-g', $user, '-m', '0750', $home, "$home/tmp"]);

        $reuse = is_dir("$app/.git") && !is_file("$app/config/config.php");
        if (!$reuse && !$this->emptyish($app)) {
            throw new RuntimeException("La cartella $app contiene già dei file: non la sovrascrivo.");
        }
        if ($reuse) {
            $this->sh(['git', '-C', $app, 'pull', '--ff-only'], $user);
        } else {
            $this->sh(['git', 'clone', '--depth', '1', '-b', $p['branch'], 'https://github.com/' . $p['repo'] . '.git', $app], $user);
        }
        $this->write("$app/storage/install.key", bin2hex(random_bytes(16)), 0640, $user);

        $dbPass = bin2hex(random_bytes(12));
        $this->redact[] = $dbPass;
        $this->sh(['mysql', '--batch'], null, [], true, "CREATE DATABASE IF NOT EXISTS `$user` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\n"
            . "CREATE USER IF NOT EXISTS '$user'@'localhost' IDENTIFIED BY '$dbPass';\n"
            . "ALTER USER '$user'@'localhost' IDENTIFIED BY '$dbPass';\n"
            . "GRANT ALL PRIVILEGES ON `$user`.* TO '$user'@'localhost';\nFLUSH PRIVILEGES;\n");

        $written = [];
        try {
            $pool = "/etc/php/$phpv/fpm/pool.d/$user.conf";
            $this->write($pool, $this->poolConfig($user, $home, $nginxUser));
            $written[] = $pool;
            $this->sh(["php-fpm$phpv", '-t']);
            $this->sh(['systemctl', 'reload', "php$phpv-fpm"]);

            $conf = "/etc/nginx/conf.d/as-$domain.conf";
            $inc = "/etc/nginx/alienshop.d/$domain";
            if ($this->dry || !is_file($conf)) {
                $this->write($conf, $this->vhost($domain, $listen));
                $written[] = $conf;
            }
            $this->sh(['install', '-d', '-m', '0755', $inc]);
            if ($this->dry || !is_file("$inc/suspend.inc")) {
                $this->write("$inc/suspend.inc", "# attivo\n");
            }
            $loc = $path === '' ? "$inc/00-root.loc" : "$inc/10-$path.loc";
            $this->write($loc, $path === '' ? $this->rootLocation($app, $user) : $this->subLocation($app, $user, $path));
            $written[] = $loc;
            if ($path === '') {
                $this->sh(['rm', '-f', "$inc/99-default.loc"]);
            } elseif ($this->dry || !is_file("$inc/00-root.loc")) {
                $site = "$base/sites/$domain";
                $this->sh(['install', '-d', '-m', '0755', $site]);
                if ($this->dry || !is_file("$site/index.html")) {
                    $this->write("$site/index.html", "<!doctype html><meta charset=\"utf-8\"><title>$domain</title>\n");
                }
                $this->write("$inc/99-default.loc", "root $site;\nindex index.html;\nlocation / { try_files \$uri \$uri/ =404; }\n");
            }
            $this->sh(['nginx', '-t']);
            $this->sh(['systemctl', 'reload', 'nginx']);
        } catch (Throwable $e) {
            foreach ($written as $f) {
                if (!$this->dry) {
                    @unlink($f);
                }
            }
            throw $e;
        }

        $env = ['ALIEN_ADMIN_PASSWORD' => $p['admin_password'], 'ALIEN_DB_PASS' => $dbPass, 'ALIEN_HUB_SECRET' => $p['hub_secret'], 'ALIEN_HUB_URL' => $p['hub_url']];
        $args = ["$app/bin/console", 'install', '--url=' . $p['url'], '--store-name=' . $name, '--admin-email=' . $p['admin_email'],
            '--db=mysql', '--db-host=localhost', '--db-name=' . $user, '--db-user=' . $user, '--theme=' . $p['theme'], '--lang=' . $p['lang'], '--demo=' . (int)!empty($p['demo'])];
        if ($proxies) {
            $args[] = '--trusted-proxies=' . implode(',', $proxies);
        }
        $this->sh(['php', ...$args], $user, $env);

        [, $sha] = $this->sh(['git', '-C', $app, 'rev-parse', 'HEAD'], $user, [], false);
        $sha = preg_match('/^[0-9a-f]{40}$/D', (string)$sha) ? (string)$sha : '';
        $this->write("$app/storage/update.json", json_encode(['sha' => $sha, 'files' => []]), 0640, $user);
        $this->sh(['rm', '-rf', "$app/.git"]);
        $this->write("/etc/cron.d/$user", "* * * * * $user /usr/bin/php $app/bin/console cron:run >/dev/null 2>&1\n");
        $this->say('== Installazione completata');
        return ['url' => $p['url'], 'database' => $user, 'user' => $user];
    }

    public function poolConfig(string $user, string $home, string $nginxUser): string
    {
        return <<<POOL
[$user]
user = $user
group = $user
listen = /run/php/$user.sock
listen.owner = $nginxUser
listen.group = $nginxUser
listen.mode = 0660
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 30s
pm.max_requests = 500
php_admin_value[open_basedir] = $home:/tmp:/usr/share/zoneinfo
php_admin_value[upload_tmp_dir] = $home/tmp
php_admin_value[sys_temp_dir] = $home/tmp
php_admin_value[upload_max_filesize] = 64M
php_admin_value[post_max_size] = 64M
php_admin_value[max_execution_time] = 120
php_admin_value[memory_limit] = 256M
php_admin_value[expose_php] = off
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec,pcntl_fork,dl
php_admin_flag[allow_url_include] = off

POOL;
    }

    public function vhost(string $domain, string $listen): string
    {
        return <<<NGX
server {
    listen $listen:80;
    server_name $domain www.$domain;
    server_tokens off;
    client_max_body_size 64m;
    include /etc/nginx/alienshop.d/$domain/suspend.inc;
    include /etc/nginx/alienshop.d/$domain/*.loc;
}

NGX;
    }

    public function rootLocation(string $app, string $user): string
    {
        return <<<NGX
root $app/public;
index index.php;
location ~ /\\.(?!well-known/) { deny all; return 404; }
location ^~ /uploads/ {
    location ~ \\.(php|phtml|phar)\$ { return 403; }
    try_files \$uri =404;
}
location ~* \\.(css|js|webp|jpg|jpeg|png|gif|svg|woff2|ico)\$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files \$uri =404;
}
location / { try_files \$uri /index.php?\$query_string; }
location ~ \\.php\$ {
    include /etc/nginx/fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $app/public/index.php;
    fastcgi_pass unix:/run/php/$user.sock;
    fastcgi_read_timeout 700s;
}

NGX;
    }

    public function subLocation(string $app, string $user, string $path): string
    {
        return <<<NGX
location ^~ /$path/ {
    alias $app/public/;
    try_files \$uri @as_$user;
    location ~ \\.(php|phtml|phar)\$ { return 404; }
}
location = /$path { try_files /__none @as_$user; }
location @as_$user {
    include /etc/nginx/fastcgi_params;
    fastcgi_pass unix:/run/php/$user.sock;
    fastcgi_param SCRIPT_FILENAME $app/public/index.php;
    fastcgi_param SCRIPT_NAME /$path/index.php;
    fastcgi_param REQUEST_URI \$request_uri;
    fastcgi_read_timeout 700s;
}

NGX;
    }

    public function addEdge(array $p): array
    {
        $this->validate($p, ['domain' => 'domain', 'hestia_user' => 'user', 'upstream' => 'upstream']);
        $user = $p['hestia_user'];
        $domain = $p['domain'];
        $this->say("== Pubblicazione di $domain tramite frontend");
        [$exists] = $this->hestia('v-list-web-domain', [$user, $domain], false);
        if ($exists !== 0 || $this->dry) {
            $this->hestia('v-add-web-domain', [$user, $domain]);
        }
        $this->write('/etc/nginx/conf.d/alienshop-cache.conf', "proxy_cache_path /var/cache/nginx/alienshop levels=1:2 keys_zone=alienshop:50m max_size=2g inactive=7d use_temp_path=off;\n");
        if (!$this->dry) {
            @mkdir('/var/cache/nginx/alienshop', 0755, true);
        }
        $this->write("/home/$user/conf/web/$domain/alienshop_edge.inc", $this->edgeConfig($p['upstream']), 0600);
        $this->hestia('v-change-web-domain-tpl', [$user, $domain, 'alienshop-edge']);
        $this->hestia('v-add-letsencrypt-domain', [$user, $domain], false);
        $this->hestia('v-add-web-domain-ssl-force', [$user, $domain], false);
        $this->hestia('v-restart-web', [], false);
        $this->say('== Frontend pronto');
        return ['upstream' => $p['upstream']];
    }

    public function edgeConfig(string $upstream): string
    {
        $common = <<<NGX
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$remote_addr;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_set_header X-Forwarded-Host \$host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
NGX;
        return <<<NGX
client_max_body_size 64m;
location ~ /hub/update\$ {
$common
    proxy_read_timeout 700s;
    proxy_cache off;
}
location / {
$common
    proxy_read_timeout 120s;
    proxy_cache alienshop;
    proxy_cache_key "\$scheme\$host\$request_uri";
    proxy_cache_bypass \$cookie_as_admin;
    proxy_no_cache \$cookie_as_admin;
    proxy_cache_lock on;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    add_header X-Edge-Cache \$upstream_cache_status always;
}

NGX;
    }

    private function suspend(array $p, bool $on): array
    {
        $this->validate($p, ['domain' => 'domain']);
        $domain = $p['domain'];
        $this->write("/etc/nginx/alienshop.d/$domain/suspend.inc", $on ? "return 503;\n" : "# attivo\n");
        $this->sh(['nginx', '-t']);
        $this->sh(['systemctl', 'reload', 'nginx']);
        return [];
    }

    private function selfUpdate(): array
    {
        $dir = dirname(realpath(__FILE__) ?: __FILE__, 2);
        $this->sh(['git', '-C', $dir, 'pull', '--ff-only']);
        return [];
    }
}

if (PHP_SAPI === 'cli' && isset($argv[0]) && realpath($argv[0]) === realpath(__FILE__)) {
    $cmd = $argv[1] ?? 'run';
    $node = new Node(Node::loadConfig(), getenv('ALIENSHOP_DRY_RUN') === '1');
    switch ($cmd) {
        case 'run':
            exit($node->run());
        case 'claim':
            if (!isset($argv[2], $argv[3])) {
                fwrite(STDERR, "Uso: alienshop-node claim UTENTE_HESTIA DOMINIO\n");
                exit(1);
            }
            exit($node->claim($argv[2], $argv[3]));
        case 'info':
            echo json_encode($node->info(), JSON_PRETTY_PRINT) . "\n";
            exit(0);
        case 'version':
            echo AGENT_VERSION . "\n";
            exit(0);
        default:
            fwrite(STDERR, "Comandi: run | claim UTENTE DOMINIO | info | version\n");
            exit(1);
    }
}
